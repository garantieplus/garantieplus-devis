# --- Supabase (table devis, back-office, cache plaque, rate limiting) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publique du site (liens des e-mails et du PDF) ---
NEXT_PUBLIC_BASE_URL=https://devis.garantieplus.fr

# --- E-mails (Brevo, API transactionnelle) ---
BREVO_API_KEY=
# Expéditeur : son domaine doit être authentifié chez Brevo.
EMAIL_FROM=Garantie Plus <devis@garantieplus.fr>
EMAIL_ADMIN=contact@garantieplus.fr

# --- Recherche par plaque : l'app garantieplus (SIV + véhiculier SRA) ---
# Clé Bearer = SITE_DEVIS_API_KEY côté app garantieplus (/api/partenaires/site-devis/*).
GARANTIEPLUS_API_URL=https://www.garantieplus.fr
GARANTIEPLUS_API_KEY=
# Repli : fournisseur SIV en direct (sans valeur à neuf) si l'app n'est pas configurée.
VEHICLE_LOOKUP_TOKEN=

# --- Inscription partenaire ---
VIRUSTOTAL_API_KEY=
