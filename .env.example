# --- Supabase (table devis, back-office, cache plaque, rate limiting) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publique du site (liens des e-mails et du PDF) ---
NEXT_PUBLIC_BASE_URL=https://devis.garantieplus.fr

# --- E-mails (Brevo, API transactionnelle) ---
BREVO_API_KEY=
# Expéditeur : son domaine doit être authentifié chez Brevo.
EMAIL_FROM=Garantie Plus <contact@garantieplus.fr>
EMAIL_ADMIN=contact@garantieplus.fr

# --- Recherche par plaque : fournisseur SIV apiplaqueimmatriculation.com ---
# La valeur à neuf et les versions viennent de la table `vehiculier` de la base Supabase
# ci-dessus (supabase-migration-2026-10-vehiculier.sql). Vide = saisie manuelle.
VEHICLE_LOOKUP_TOKEN=

# --- Inscription partenaire ---
VIRUSTOTAL_API_KEY=
